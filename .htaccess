# Keine Inhaltsaushandlung: /preise soll per 301 auf preise.html, nicht still ausgeliefert werden
Options -MultiViews
# IONOS hat mod_speling an: fehlende Dateien liefern sonst "300 Multiple Choices" mit aehnlichen
# Dateinamen statt 404. Abgeschaltet am 10.11.2026.
CheckSpelling Off
ErrorDocument 404 /404.html

RewriteEngine On

# www und http in einem Schritt auf https://cleanconnect.de
RewriteCond %{HTTP_HOST} ^www\.cleanconnect\.de [NC]
RewriteRule ^ https://cleanconnect.de%{REQUEST_URI} [L,R=301]

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Root redirect to /cleanconnect/
# Greift nur, wenn diese Datei im Web-Verzeichnis selbst liegt. deploy.yml legt sie eine Ebene
# darueber ab (put -O /), dort feuert die Regel fuer cleanconnect.de nicht. Nicht ins Web-Verzeichnis kopieren.
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ /cleanconnect/ [L,R=301]

# Adressen ohne Endung auf die .html-Seite. Bewusst RedirectMatch statt RewriteRule:
# Im Web-Verzeichnis liegt eine eigene .htaccess mit RewriteEngine, die die Rewrite-Regeln
# dieser Datei verdraengt. Redirect-Regeln werden dagegen zusammengefuehrt (live geprueft 04.11.2026).
# Neue Seiten hier ergaenzen, sonst liefert IONOS (mod_speling) "300 Multiple Choices".
RedirectMatch 301 ^/(preise|rechner|standorte|impressum|datenschutz|agb|widerruf|angebot|broschuere|bueroreinigung-koeln|fragen|preisspiegel|team|vorher-nachher)/?$ /$1.html
RedirectMatch 301 ^/(standorte|blog)/([a-z0-9-]+)$ /$1/$2.html
# Alte Bildnamen auf sprechende Namen (09.11.2026), damit Google-Bilder und alte Links weiter funktionieren
RedirectMatch 301 ^/images/img_01(-560)?\.(webp|jpg)$ /images/showroom-reinigung-harley-davidson-koeln$1.$2
RedirectMatch 301 ^/images/img_03(-560)?\.(webp|jpg)$ /images/reinigung-verkaufsraum-harley-davidson-koeln$1.$2
RedirectMatch 301 ^/images/img_04(-560)?\.(webp|jpg)$ /images/oberflaechenreinigung-verkaufstheke-koeln$1.$2
RedirectMatch 301 ^/images/img_05(-560)?\.(webp|jpg)$ /images/treppenhausreinigung-wohnanlage-koeln$1.$2
RedirectMatch 301 ^/images/img_06(-560)?\.(webp|jpg)$ /images/unterhaltsreinigung-harley-davidson-store-koeln$1.$2
RedirectMatch 301 ^/images/img_07(-560)?\.(webp|jpg)$ /images/clean-connect-mitarbeiterin-firmenfahrzeug-koeln$1.$2
RedirectMatch 301 ^/images/img_08(-560)?\.(webp|jpg)$ /images/reinigungskraft-motorrad-showroom-koeln$1.$2
RedirectMatch 301 ^/images/img_10(-560)?\.(webp|jpg)$ /images/clean-connect-firmenwagen-gewerbeobjekt-koeln$1.$2
RedirectMatch 301 ^/images/img_12(-560)?\.(webp|jpg)$ /images/teppichreinigung-verkaufsraum-koeln$1.$2
RedirectMatch 301 ^/images/img_13(-560)?\.(webp|jpg)$ /images/kundenobjekt-harley-davidson-koeln-bonn$1.$2
RedirectMatch 301 ^/images/img_14(-560)?\.(webp|jpg)$ /images/glasreinigung-schaufenster-koeln$1.$2
RedirectMatch 301 ^/images/img\-003(-560)?\.(webp|jpg)$ /images/fynn-laubkermeier-geschaeftsfuehrer-clean-connect$1.$2
RedirectMatch 301 ^/images/img\-004(-560)?\.(webp|jpg)$ /images/clean-connect-logo$1.$2
RedirectMatch 301 ^/images/logo\-96(-560)?\.(webp|jpg)$ /images/clean-connect-logo-96$1.$2
# Vorher/Nachher-Bilder mit sprechenden Namen (10.11.2026)
RedirectMatch 301 ^/images/praxis/bauend\-atrium\-vorher\.webp$ /images/praxis/bauendreinigung-atrium-buerogebaeude-vorher.webp
RedirectMatch 301 ^/images/praxis/bauend\-atrium\-nachher\.webp$ /images/praxis/bauendreinigung-atrium-buerogebaeude-nachher.webp
RedirectMatch 301 ^/images/praxis/bauend\-bueroflaeche\-vorher\.webp$ /images/praxis/bauendreinigung-bueroflur-vorher.webp
RedirectMatch 301 ^/images/praxis/bauend\-bueroflaeche\-nachher\.webp$ /images/praxis/bauendreinigung-bueroflur-nachher.webp
RedirectMatch 301 ^/images/praxis/bauend\-teppich\-tuer\-vorher\.webp$ /images/praxis/bauendreinigung-teppichboden-buero-vorher.webp
RedirectMatch 301 ^/images/praxis/bauend\-teppich\-tuer\-nachher\.webp$ /images/praxis/bauendreinigung-teppichboden-buero-nachher.webp
RedirectMatch 301 ^/images/praxis/bauend\-treppe\-vorher\.webp$ /images/praxis/bauendreinigung-granittreppe-vorher.webp
RedirectMatch 301 ^/images/praxis/bauend\-treppe\-nachher\.webp$ /images/praxis/bauendreinigung-granittreppe-nachher.webp
RedirectMatch 301 ^/images/praxis/cafe\-boden\-vorher\.webp$ /images/praxis/grundreinigung-cafe-boden-vorher.webp
RedirectMatch 301 ^/images/praxis/cafe\-boden\-maschine\.webp$ /images/praxis/grundreinigung-cafe-boden-einscheibenmaschine.webp
RedirectMatch 301 ^/images/praxis/cafe\-boden\-nasssauger\.webp$ /images/praxis/grundreinigung-cafe-boden-nasssauger.webp
RedirectMatch 301 ^/images/praxis/fassade\-klinker\-vorher\.webp$ /images/praxis/fassadenreinigung-klinkerfassade-vorher.webp
RedirectMatch 301 ^/images/praxis/fassade\-klinker\-nachher\.webp$ /images/praxis/fassadenreinigung-klinkerfassade-nachher.webp
RedirectMatch 301 ^/images/praxis/fenster\-vorher\.webp$ /images/praxis/fensterreinigung-buerofenster-vorher.webp
RedirectMatch 301 ^/images/praxis/fenster\-nachher\.webp$ /images/praxis/fensterreinigung-buerofenster-nachher.webp
RedirectMatch 301 ^/images/praxis/glasdach\-vorher\.webp$ /images/praxis/glasdachreinigung-eingang-vorher.webp
RedirectMatch 301 ^/images/praxis/glasdach\-nachher\.webp$ /images/praxis/glasdachreinigung-eingang-nachher.webp
RedirectMatch 301 ^/images/praxis/kueche\-fliesenboden\-vorher\.webp$ /images/praxis/grundreinigung-gewerbekueche-fliesenboden-vorher.webp
RedirectMatch 301 ^/images/praxis/kueche\-fliesenboden\-nachher\.webp$ /images/praxis/grundreinigung-gewerbekueche-fliesenboden-nachher.webp
RedirectMatch 301 ^/images/praxis/sanitaer\-wc\-vorher\.webp$ /images/praxis/sanitaerreinigung-wc-buero-vorher.webp
RedirectMatch 301 ^/images/praxis/sanitaer\-wc\-nachher\.webp$ /images/praxis/sanitaerreinigung-wc-buero-nachher.webp
RedirectMatch 301 ^/images/praxis/teekueche\-spuele\-vorher\.webp$ /images/praxis/bueroreinigung-teekueche-spuele-vorher.webp
RedirectMatch 301 ^/images/praxis/teekueche\-spuele\-nachher\.webp$ /images/praxis/bueroreinigung-teekueche-spuele-nachher.webp

# Versteckte Dateien (.env, .htaccess ...) nicht ueber die Rechtschreibkorrektur auflisten
RedirectMatch 404 ^/\.(?!well-known/)

# Gzip-Kompression fuer schnellere Uebertragung
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>

# Cache-Control for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp              "access plus 30 days"
  ExpiresByType image/png               "access plus 30 days"
  ExpiresByType image/jpeg              "access plus 30 days"
  ExpiresByType video/mp4               "access plus 30 days"
  ExpiresByType font/woff2              "access plus 30 days"
  ExpiresByType text/css                "access plus 1 day"
  ExpiresByType application/javascript  "access plus 1 day"
  ExpiresByType text/javascript         "access plus 1 day"
  ExpiresByType text/html               "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(?:webp|png|jpe?g|mp4|woff2)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
  # CSS und JS tragen keinen Hash im Namen, deshalb nur einen Tag und ohne immutable
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.(?:html|ico)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>
